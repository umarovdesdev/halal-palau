# Supabase подключение (необязательно — без переменных включается локальный режим)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Email администратора для входа в Supabase (необязательно — скрывает поле email при входе)
VITE_ADMIN_EMAIL=admin@example.com

# PBKDF2-хэш пароля админки для локального режима (без Supabase)
VITE_ADMIN_PASSWORD_HASH=pbkdf2$600000$<salt>$<hash>  # node scripts/hash-password.mjs
